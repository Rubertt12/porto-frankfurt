{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Porto Frankfurt",
  "version": "1.0.0",
  "identifier": "br.com.portofrankfurt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Porto Frankfurt",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Gestão condominial offline e online",
    "longDescription": "Aplicativo desktop do Porto Frankfurt com banco de dados SQLite local."
  }
}